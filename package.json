{
  "name": "earth-jukebox",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "sample": "python3 backend/make_fixture.py data/sample && python3 backend/build_api.py backend/sample.config.json",
    "api": "python3 backend/build_api.py backend/tracks.config.json",
    "climate": "python3 scripts/climate_data.py",
    "validate": "python3 backend/validate_api.py public",
    "test:backend": "python3 -m unittest discover backend/tests -v",
    "build": "esbuild src/engine.js --bundle --format=iife --global-name=EJ --minify --outfile=public/bundle.js",
    "serve": "python3 scripts/serve.py 8000",
    "test": "node test/run.cjs",
    "test:responsive": "node test/responsive.cjs"
  },
  "dependencies": {
    "tone": "15.1.22"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  }
}
